# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Service IA ordonnances (OCR + extraction médicaments). Port 3001 pour ne pas conflit avec l'API (3000). Démarrer : cd IA_E-Sante/medical-ai && node server.js
MEDICAL_AI_URL=http://localhost:3001

# Email (SMTP) - Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kanoutecoumba00@gmail.com
SMTP_PASS=gjvbiduqquwrvhtv
SMTP_FROM=E-Sante <noreply@e-sante.com>

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS (production) — origines autorisées pour la connexion (séparées par des virgules)
